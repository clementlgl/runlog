{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "frontend-dev",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--dir", "frontend", "dev", "--port", "5173", "--strictPort"],
			"env": { "API_URL": "http://localhost:8000" },
			"port": 5173
		},
		{
			"name": "backend-dev",
			"runtimeExecutable": "poetry",
			"runtimeArgs": ["-C", "backend", "run", "uvicorn", "app.main:app", "--app-dir", ".", "--port", "8011", "--reload", "--reload-dir", "app"],
			"env": { "DB_PATH": "../data/runs-dev.duckdb" },
			"port": 8011, "autoPort": false
		},
		{
			"name": "frontend-dev-local",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--dir", "frontend", "dev", "--port", "5174", "--strictPort"],
			"env": { "API_URL": "http://localhost:8011" },
			"port": 5174
		}
	]
}
