# Copy to .env and adjust. Every variable is optional: unset = default shown.

# Web app: interface and port it listens on, on the host.
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from the LAN (behind Caddy).
RUNLOG_BIND=127.0.0.1
RUNLOG_PORT=3000

# Public URL of the app, exactly as typed in the browser.
# Default: http://localhost:<RUNLOG_PORT>. Behind a reverse proxy, e.g.:
# RUNLOG_ORIGIN=https://runlog.example.com
RUNLOG_ORIGIN=

# Backend API (+ /docs). The web app does not need it published.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000

# Xiaomi account region, forced when logging in from the app.
# de = Europe (France...), sg = Asia, us = Americas, ru, i2 = India, cn = China.
MIFIT_REGION=de

# Folder holding the mifit session (session.json). Default: ~/.mifit
# It gives access to the whole Xiaomi account: keep it chmod 600, out of git.
MIFIT_SESSION_DIR=

# Folder for exports and the DuckDB database. Default: ./data
RUNLOG_DATA_DIR=
